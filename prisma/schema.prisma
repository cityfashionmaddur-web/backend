generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  googleId       String   @unique
  email          String   @unique
  name           String
  profilePicture String?
  role           Role     @default(CUSTOMER)
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?  @db.Text
  price       Decimal
  compareAtPrice Decimal?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categoryId  Int?
  instagramLink String?
  colorGroup  String?
  colorLabel  String?
  isCombo     Boolean  @default(false)
  comboTopSizes Json?
  comboBottomSizes Json?
  availableColors String?
  category    Category? @relation(fields: [categoryId], references: [id])

  orderItems    OrderItem[]
  productImages ProductImage[]
  variants      ProductVariant[]
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)

  @@unique([productId, size])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  url       String
}

model Order {
  id          Int         @id @default(autoincrement())
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
  totalAmount Decimal
  status      OrderStatus @default(PENDING)
  paymentId   String?
  razorpayOrderId String?
  razorpaySignature String?
  paymentMethod String? @default("razorpay")
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?
  trackingCode String?
  trackingCarrier String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  price     Decimal
  size      String?
}

model Collection {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  showInNav Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]
}

model Category {
  id           Int         @id @default(autoincrement())
  name         String
  slug         String      @unique
  description  String?
  collectionId Int?
  collection   Collection? @relation(fields: [collectionId], references: [id], map: "Category_collection_fkey_mapped")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  products Product[]
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  title     String?
  subtitle  String?
  image     String
  badge     String?
  caption   String?

  cta1Label String?
  cta1Href  String?
  cta2Label String?
  cta2Href  String?

  tags      String?

  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
